# Copy to .env.local and fill in. NEVER commit real values.

# --- Supabase (managed, EU region) ---------------------------------
# Project URL and the public anon key (safe for the browser; RLS-gated).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Full bypass of RLS — must NEVER reach the browser or logs.
# Only used by trusted server code (never in a NEXT_PUBLIC_ variable).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Media (chosen later: Immich or object storage) ----------------
# IMMICH_URL=https://immich.your-domain.eu
# IMMICH_API_KEY=
